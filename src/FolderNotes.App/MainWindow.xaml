<?xml version="1.0" encoding="utf-8"?>
<!-- Main window (specs/05 § Main window, § Library behaviour): NavigationView with All notes, Labels, Orphaned and Settings. -->
<Window
    x:Class="FolderNotes.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:library="using:FolderNotes.App.Library"
    Title="Folder Notes">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <!-- No Background: Mica (or its solid fallback) shows through (specs/05 § Design tokens, Backdrops). -->
  <Grid x:Name="Root">
    <NavigationView x:Name="Nav" PaneDisplayMode="Auto" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="True" AutomationProperties.AutomationId="Navigation"
                    SelectionChanged="OnNavSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="AllNotesItem" Content="All notes" Tag="library" AutomationProperties.AutomationId="NavAllNotes">
          <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="LabelsItem" Content="Labels" Tag="labels" AutomationProperties.AutomationId="NavLabels">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Tag" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="OrphansItem" Content="Orphaned" Tag="orphans" AutomationProperties.AutomationId="NavOrphaned">
          <!-- The count badge is set in code (MainWindow.OnOrphansChanged). -->
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="SettingsItem" Content="Settings" Tag="settings" AutomationProperties.AutomationId="NavSettings">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24,8,24,0" Spacing="{StaticResource SpacingS}">
          <InfoBar x:Name="ErrorBar" AutomationProperties.AutomationId="StartupError" Severity="Error"
                   Title="Something went wrong" IsClosable="False" IsOpen="False" />
          <!-- Last routed command that has no screen yet (search until T2.6); lets manual checks see that forwarding worked. -->
          <InfoBar x:Name="RequestBar" AutomationProperties.AutomationId="LastRequest" Severity="Informational"
                   IsClosable="True" IsOpen="False" />
        </StackPanel>

        <library:LibraryPage x:Name="Library" Grid.Row="1" />
        <!-- Labels, Orphaned and Settings are created in code on first visit (MainWindow.EnsurePage). -->
        <Grid x:Name="PageHost" Grid.Row="1" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
