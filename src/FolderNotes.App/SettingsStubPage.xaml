<?xml version="1.0" encoding="utf-8"?>
<!-- Settings stub until T2.8: only the theme choice (not saved across restarts yet). Created on first visit. -->
<UserControl
    x:Class="FolderNotes.App.SettingsStubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="24,16">
    <StackPanel Spacing="{StaticResource SpacingL}" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" />
      <RadioButtons x:Name="ThemeChoice" x:FieldModifier="internal" Header="Theme" MaxColumns="3"
                    AutomationProperties.AutomationId="ThemeChoice">
        <x:String>System</x:String>
        <x:String>Light</x:String>
        <x:String>Dark</x:String>
      </RadioButtons>
      <TextBlock Text="More settings arrive with the Settings page." Style="{StaticResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
