<Project Sdk="Microsoft.NET.Sdk">
  <!-- WinUI 3 tray app: main window, search palette, companion panel (specs/02-architecture.md). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>FolderNotes.App</RootNamespace>
    <AssemblyName>FolderNotes</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- S2: without PerMonitorV2 the panel docks 1.25x off at 125% scaling. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FolderNotes.ico</ApplicationIcon>
    <!-- T2.1: Program.Main does the single-instance check before any XAML exists (specs/02 § App shell). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Tray icon P/Invoke uses fixed buffers and function pointers (ADR-012). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\FolderNotes.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FolderNotes.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FolderNotes.Core\FolderNotes.Core.csproj" />
  </ItemGroup>
</Project>
