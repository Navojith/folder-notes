<?xml version="1.0" encoding="utf-8"?>
<!-- The search palette (specs/05 § Search palette, § Search palette behaviour, REQ-050…053). -->
<Window
    x:Class="FolderNotes.App.Search.SearchPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FolderNotes.App.Controls"
    xmlns:local="using:FolderNotes.App.Search"
    xmlns:domain="using:FolderNotes.Core.Domain"
    Title="Search · Folder Notes">
  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>
  <Grid x:Name="Root" Padding="12,12,12,8" RowSpacing="8" VerticalAlignment="Top">
    <Grid.Resources>
      <DataTemplate x:Key="ResultTemplate" x:DataType="local:SearchResultRow">
        <Grid ColumnSpacing="10" RowSpacing="2" Padding="0,6" Height="52" AutomationProperties.Name="{x:Bind Row.AccessibleName}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <controls:AccentBar Grid.RowSpan="2" ColorKey="{x:Bind Row.AccentColor}" VerticalAlignment="Stretch" />
          <controls:HighlightedText Grid.Column="1" Text="{x:Bind Row.Title}" Ranges="{x:Bind TitleRanges}"
                                    TextStyle="{StaticResource BodyStrongTextBlockStyle}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
            <controls:StatusPill Status="{x:Bind Row.Status}" />
            <ItemsRepeater ItemsSource="{x:Bind Row.Chips}">
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="domain:Label">
                  <controls:LabelChip LabelName="{x:Bind Name}" ColorKey="{x:Bind Color}" />
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
              <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="4" /></ItemsRepeater.Layout>
            </ItemsRepeater>
          </StackPanel>
          <controls:HighlightedText Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind Details}" Ranges="{x:Bind PathRanges}"
                                    TextStyle="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
      </DataTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="QueryBox" FontSize="18" PlaceholderText="Search notes   (label:  status:  due:  path:)"
             AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Search notes"
             TextChanged="OnQueryChanged" SelectionChanged="OnQuerySelectionChanged" />
    <TextBlock x:Name="ErrorText" Grid.Row="1" AutomationProperties.AutomationId="SearchError" Visibility="Collapsed"
               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />

    <Grid Grid.Row="2">
      <ListView x:Name="ResultList" AutomationProperties.AutomationId="SearchResults" AutomationProperties.Name="Results"
                SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnResultClick" MaxHeight="448"
                ItemTemplate="{StaticResource ResultTemplate}" IsTabStop="False" />
      <ListView x:Name="SuggestionList" AutomationProperties.AutomationId="SearchSuggestions" AutomationProperties.Name="Suggestions"
                SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnSuggestionClick" Visibility="Collapsed"
                IsTabStop="False" />
      <TextBlock x:Name="EmptyText" AutomationProperties.AutomationId="SearchEmpty" Visibility="Collapsed" Margin="4,8"
                 Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>

    <Grid Grid.Row="3" ColumnSpacing="12" Padding="4,4,4,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="FooterText" AutomationProperties.AutomationId="SearchFooter" AutomationProperties.LiveSetting="Polite"
                 Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="CountText" Grid.Column="1" AutomationProperties.AutomationId="SearchCount" AutomationProperties.LiveSetting="Polite"
                 Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
  </Grid>
</Window>
