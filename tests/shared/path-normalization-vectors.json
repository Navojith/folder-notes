    },
    {
      "category": "unicode",
      "input": "C:\\Έγγραφα",
      "expected": "C:\\ΈΓΓΡΑΦΑ",
      "note": "Greek"
    },
    {
      "category": "unicode",
      "input": "C:\\文档\\照片",
      "expected": "C:\\文档\\照片",
      "note": "CJK has no case"
    },
    {
      "category": "unicode",
      "input": "C:\\Photos 📷\\2026",
      "expected": "C:\\PHOTOS 📷\\2026",
      "note": "emoji (surrogate pair) kept"
    },
    {
      "category": "long",
      "input": "C:\\Segment00-long-folder-name\\Segment01-long-folder-name\\Segment02-long-folder-name\\Segment03-long-folder-name\\Segment04-long-folder-name\\Segment05-long-folder-name\\Segment06-long-folder-name\\Segment07-long-folder-name\\Segment08-long-folder-name\\Segment09-long-folder-name\\Segment10-long-folder-name\\Segment11-long-folder-name\\",
      "expected": "C:\\SEGMENT00-LONG-FOLDER-NAME\\SEGMENT01-LONG-FOLDER-NAME\\SEGMENT02-LONG-FOLDER-NAME\\SEGMENT03-LONG-FOLDER-NAME\\SEGMENT04-LONG-FOLDER-NAME\\SEGMENT05-LONG-FOLDER-NAME\\SEGMENT06-LONG-FOLDER-NAME\\SEGMENT07-LONG-FOLDER-NAME\\SEGMENT08-LONG-FOLDER-NAME\\SEGMENT09-LONG-FOLDER-NAME\\SEGMENT10-LONG-FOLDER-NAME\\SEGMENT11-LONG-FOLDER-NAME",
      "note": "path longer than MAX_PATH"
    },
    {
      "category": "long",
      "input": "\\\\?\\C:\\Segment00-long-folder-name\\Segment01-long-folder-name\\Segment02-long-folder-name\\Segment03-long-folder-name\\Segment04-long-folder-name\\Segment05-long-folder-name\\Segment06-long-folder-name\\Segment07-long-folder-name\\Segment08-long-folder-name\\Segment09-long-folder-name\\Segment10-long-folder-name\\Segment11-long-folder-name\\",
      "expected": "C:\\SEGMENT00-LONG-FOLDER-NAME\\SEGMENT01-LONG-FOLDER-NAME\\SEGMENT02-LONG-FOLDER-NAME\\SEGMENT03-LONG-FOLDER-NAME\\SEGMENT04-LONG-FOLDER-NAME\\SEGMENT05-LONG-FOLDER-NAME\\SEGMENT06-LONG-FOLDER-NAME\\SEGMENT07-LONG-FOLDER-NAME\\SEGMENT08-LONG-FOLDER-NAME\\SEGMENT09-LONG-FOLDER-NAME\\SEGMENT10-LONG-FOLDER-NAME\\SEGMENT11-LONG-FOLDER-NAME",
      "note": "long path with prefix"
